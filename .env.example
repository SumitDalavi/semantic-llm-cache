# .env.example — semantic-llm-cache
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── AI Providers ─────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Deterministic pseudo-normalized mock embeddings (CI-safe)
# SET to OpenAI key (sk-...): Live text-embedding-3-small embeddings
OPENAI_API_KEY=

# Optional Anthropic key
ANTHROPIC_API_KEY=

# ── Redis / Semantic Cache Store ─────────────────────────────────────────
# UNSET: redis://localhost:6379
# SET to redis URL: Managed Redis cluster
REDIS_URL=redis://localhost:6379

# ── Configuration & Tuning ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
SIMILARITY_THRESHOLD=0.95
DEFAULT_TTL_SECONDS=86400
METRICS_PORT=9090
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
